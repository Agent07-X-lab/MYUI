<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@null"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/widget_layout_dotmatrix"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/left_portion"
            android:background="@drawable/calc4_btn_bg"
            android:padding="8dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.8"
            android:layout_marginEnd="6dp">
            <ImageView
                android:id="@+id/weather_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginBottom="4dp"
                android:scaleType="fitCenter"/>
            <TextView
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text"
                android:id="@+id/temperature_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:fontFamily="@font/mainb"/>
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text"
                android:ellipsize="end"
                android:id="@+id/weather_condition_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:alpha="0.8"
                android:fontFamily="@font/mainb"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/right_portion"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2.2"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp">
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/widget_accent"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/city_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:fontFamily="@font/mainb"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/forecast_row1"
                    android:background="@drawable/calc4_btn_bg"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="3dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="8dp">
                    <TextView
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text"
                        android:id="@+id/forecast_day1_text"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:alpha="0.75"
                        android:fontFamily="@font/mainb"/>
                    <ImageView
                        android:id="@+id/forecast_icon1"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:scaleType="fitCenter"/>
                    <TextView
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text"
                        android:gravity="end"
                        android:id="@+id/forecast_temp1_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:fontFamily="@font/mainb"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/forecast_row2"
                    android:background="@drawable/calc4_btn_bg"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="3dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="8dp">
                    <TextView
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text"
                        android:id="@+id/forecast_day2_text"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:alpha="0.75"
                        android:fontFamily="@font/mainb"/>
                    <ImageView
                        android:id="@+id/forecast_icon2"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:scaleType="fitCenter"/>
                    <TextView
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text"
                        android:gravity="end"
                        android:id="@+id/forecast_temp2_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:fontFamily="@font/mainb"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/forecast_row3"
                    android:background="@drawable/calc4_btn_bg"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="8dp">
                    <TextView
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text"
                        android:id="@+id/forecast_day3_text"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:alpha="0.75"
                        android:fontFamily="@font/mainb"/>
                    <ImageView
                        android:id="@+id/forecast_icon3"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:scaleType="fitCenter"/>
                    <TextView
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text"
                        android:gravity="end"
                        android:id="@+id/forecast_temp3_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:fontFamily="@font/mainb"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
