<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:backgroundTint="@color/widget_background_light">
        <LinearLayout
            android:id="@+id/search_capsule"
            android:background="@drawable/widget_background_small_corners"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:paddingStart="20dp"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="20dp"
            android:backgroundTint="@color/widget_background_light"
            android:paddingHorizontal="120dp"
            android:paddingVertical="16dp">
            <ImageView
                android:id="@+id/search_logo"
                android:layout_width="90dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search_logo2"
                android:scaleType="fitCenter"
                android:tint="@color/widget_text"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="end"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="30dp">
            <ImageView
                android:id="@+id/gemini_icon"
                android:padding="6dp"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_gemini"
                android:scaleType="fitCenter"
                android:tint="@color/widget_text"
                android:contentDescription="Gemini"
                android:layout_marginEnd="12dp"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
