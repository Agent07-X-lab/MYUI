<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_container"
        android:background="@drawable/capsul_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="@color/widget_background_light"/>
    <RelativeLayout
        android:id="@+id/compass_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/compass_dial"
            android:padding="2dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_compass_arrow_1"
            android:scaleType="fitCenter"
            android:layout_centerInParent="true"
            android:contentDescription="Compass dial"/>
        <ImageView
            android:id="@+id/compass_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/compass_arrow"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:maxWidth="80dp"
            android:maxHeight="80dp"
            android:layout_centerInParent="true"
            android:contentDescription="Compass arrow"/>
    </RelativeLayout>
</RelativeLayout>
