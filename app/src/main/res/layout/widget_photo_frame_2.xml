<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:padding="0dp"
    android:focusable="true"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/left_photo_container"
        android:background="@drawable/rounded_widget_background_dual"
        android:padding="3dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="-20dp"
        android:layout_toStartOf="@+id/center_icon_container"
        android:layout_alignParentStart="true">
        <ImageView
            android:id="@+id/widget_photo_left"
            android:background="@drawable/rounded_image_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/widget_photo_description"
            android:clipToOutline="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/right_photo_container"
        android:background="@drawable/rounded_widget_background_dual"
        android:padding="3dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="-20dp"
        android:layout_toEndOf="@+id/center_icon_container"
        android:layout_alignParentEnd="true">
        <ImageView
            android:id="@+id/widget_photo_right"
            android:background="@drawable/rounded_image_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/widget_photo_description"
            android:clipToOutline="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/center_icon_container"
        android:background="@drawable/capsul_bg_on"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_centerInParent="true"
        android:elevation="5dp">
        <ImageView
            android:id="@+id/heart_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_heart"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="18sp"
        android:textColor="#ffffff"
        android:id="@+id/config_text"
        android:background="#80000000"
        android:padding="16dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tap_to_configure"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/custom_text_left"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_alignParentBottom="true"
        android:contentDescription="@string/widget_custom_text"
        android:layout_marginStart="12dp"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/custom_text_right"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_alignParentBottom="true"
        android:contentDescription="@string/widget_custom_text"
        android:layout_marginEnd="12dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
