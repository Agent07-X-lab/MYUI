<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_background"
        android:scaleType="fitXY"
        android:tint="@color/widget_background_light"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/widget_container"
        android:padding="0dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp">
            <FrameLayout
                android:id="@+id/google_capsule"
                android:background="@drawable/widget_background_on"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/widget_accent">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/google_icon"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_google_logo"
                    android:scaleType="fitCenter"
                    android:tint="@color/widget_text"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <FrameLayout
                    android:id="@+id/lens_capsule"
                    android:background="@drawable/widget_background"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="2dp"
                    android:backgroundTint="@color/widget_background_light">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/lens_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_google_lens"
                        android:tint="@color/widget_text"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/assistant_capsule"
                    android:background="@drawable/widget_background"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:backgroundTint="@color/widget_background_light">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/assistant_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_gemini"
                        android:tint="@color/widget_text"/>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="4dp"
                android:layout_weight="1">
                <FrameLayout
                    android:id="@+id/photos_capsule"
                    android:background="@drawable/widget_background"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="2dp"
                    android:backgroundTint="@color/widget_background_light">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/photos_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_google_photos"
                        android:tint="@color/widget_text"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/chrome_capsule"
                    android:background="@drawable/widget_background"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp"
                    android:backgroundTint="@color/widget_background_light">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/chrome_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_chrome"
                        android:tint="@color/widget_text"/>
                </FrameLayout>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/youtube_capsule"
                android:background="@drawable/widget_background_on"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:backgroundTint="@color/widget_accent">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/youtube_icon"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_youtube_logo"
                    android:scaleType="fitCenter"
                    android:tint="@color/widget_text"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
