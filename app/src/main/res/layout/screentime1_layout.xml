<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_background"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"/>
    <LinearLayout
        android:gravity="start"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="start|top"
            android:orientation="horizontal"
            android:padding="15dp"
            android:paddingBottom="4dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3.5">
            <ImageView
                android:id="@+id/device_icon"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginTop="0dp"
                android:src="@drawable/ic_device"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:tint="@color/screentime_social"
                android:layout_marginStart="0dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="start|bottom"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"
            android:paddingStart="15dp"
            android:paddingEnd="15dp">
            <ImageView
                android:id="@+id/screentime_time_image"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginBottom="5dp"
                android:scaleType="fitStart"
                android:adjustViewBounds="true"
                android:maxHeight="42dp"
                android:tint="@color/widget_text"
                android:contentDescription="Screen Time Duration. Tap to refresh."/>
            <ImageView
                android:id="@+id/screentime_title_image"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:scaleType="fitStart"
                android:adjustViewBounds="true"
                android:maxHeight="24dp"
                android:tint="@color/widget_text"
                android:contentDescription="Screen Time"
                android:alpha="0.4"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="15dp"
            android:paddingEnd="15dp">
            <ImageView
                android:id="@+id/progress_bar_image"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:scaleType="fitXY"
                android:adjustViewBounds="false"
                android:contentDescription="Usage Progress Bar"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
