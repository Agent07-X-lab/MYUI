<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:backgroundTint="@color/widget_background_light"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/sunrise_section"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/sunriseTimeImage"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:scaleType="fitStart"
                android:adjustViewBounds="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:id="@+id/sunriseIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_sunrise"
                android:scaleType="fitEnd"/>
            <TextView
                android:id="@+id/sunriseTimeText"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/sunset_section"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/sunsetTimeImage"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:scaleType="fitStart"
                android:adjustViewBounds="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:id="@+id/sunsetIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_sunset"
                android:scaleType="fitEnd"/>
            <TextView
                android:id="@+id/sunsetTimeText"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
        <TextView
            android:textSize="10sp"
            android:gravity="center"
            android:id="@+id/cityNameText"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.4"
            android:textAllCaps="true"
            android:fontFamily="@font/mainr"
            android:letterSpacing="0.2"/>
        <ImageView
            android:id="@+id/refreshButton"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"/>
    </LinearLayout>
</RelativeLayout>
