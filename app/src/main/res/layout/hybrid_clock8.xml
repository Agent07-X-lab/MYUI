<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:backgroundTint="@color/widget_background"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/foreground_capsule"
        android:background="@drawable/widget_background_small_corners"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:backgroundTint="@color/white">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextClock
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/widget_accent"
                android:id="@+id/widget_time_hour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-bold"
                android:format12Hour="hh"
                android:format24Hour="HH"
                android:letterSpacing="-0.02"/>
            <TextClock
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text"
                android:id="@+id/widget_time_minute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-bold"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:letterSpacing="-0.02"/>
        </LinearLayout>
        <TextClock
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text"
            android:layout_gravity="center"
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:alpha="0.7"
            android:textAllCaps="true"
            android:fontFamily="sans-serif-bold"
            android:format12Hour="EEE, MMM d"
            android:format24Hour="EEE, MMM d"/>
    </LinearLayout>
</RelativeLayout>
