<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:backgroundTint="@color/widget_background_light"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="2">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:weightSum="2"
            android:layout_weight="1">
            <FrameLayout
                android:id="@+id/app_icon_0"
                android:background="@drawable/widget_background_alt"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/widget_text"
                    android:gravity="center"
                    android:id="@+id/app_initial_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/tap_to_configure"
                    android:fontFamily="@font/nothing_font"/>
                <ImageView
                    android:id="@+id/app_image_0"
                    android:padding="12dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/app_icon"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/app_icon_1"
                android:background="@drawable/widget_background_alt"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/widget_text"
                    android:gravity="center"
                    android:id="@+id/app_initial_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text=""
                    android:fontFamily="@font/nothing_font"/>
                <ImageView
                    android:id="@+id/app_image_1"
                    android:padding="12dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/app_icon"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:weightSum="2"
            android:layout_weight="1">
            <GridLayout
                android:padding="1dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:rowCount="2"
                android:columnCount="2">
                <FrameLayout
                    android:id="@+id/app_icon_2"
                    android:background="@drawable/widget_background_alt"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="1dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1">
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/widget_text"
                        android:gravity="center"
                        android:id="@+id/app_initial_2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text=""
                        android:fontFamily="@font/nothing_font"/>
                    <ImageView
                        android:id="@+id/app_image_2"
                        android:padding="4dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/app_icon"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/app_icon_3"
                    android:background="@drawable/widget_background_alt"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="1dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1">
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/widget_text"
                        android:gravity="center"
                        android:id="@+id/app_initial_3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text=""
                        android:fontFamily="@font/nothing_font"/>
                    <ImageView
                        android:id="@+id/app_image_3"
                        android:padding="4dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/app_icon"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/app_icon_4"
                    android:background="@drawable/widget_background_alt"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="1dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1">
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/widget_text"
                        android:gravity="center"
                        android:id="@+id/app_initial_4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text=""
                        android:fontFamily="@font/nothing_font"/>
                    <ImageView
                        android:id="@+id/app_image_4"
                        android:padding="4dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/app_icon"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/app_icon_5"
                    android:background="@drawable/widget_background_alt"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="1dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1">
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/widget_text"
                        android:gravity="center"
                        android:id="@+id/app_initial_5"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text=""
                        android:fontFamily="@font/nothing_font"/>
                    <ImageView
                        android:id="@+id/app_image_5"
                        android:padding="4dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/app_icon"/>
                </FrameLayout>
            </GridLayout>
            <GridLayout
                android:padding="1dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:rowCount="2"
                android:columnCount="2">
                <FrameLayout
                    android:id="@+id/app_icon_6"
                    android:background="@drawable/widget_background_alt"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="1dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1">
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/widget_text"
                        android:gravity="center"
                        android:id="@+id/app_initial_6"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text=""
                        android:fontFamily="@font/nothing_font"/>
                    <ImageView
                        android:id="@+id/app_image_6"
                        android:padding="4dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/app_icon"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/app_icon_7"
                    android:background="@drawable/widget_background_alt"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="1dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1">
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/widget_text"
                        android:gravity="center"
                        android:id="@+id/app_initial_7"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text=""
                        android:fontFamily="@font/nothing_font"/>
                    <ImageView
                        android:id="@+id/app_image_7"
                        android:padding="4dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/app_icon"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/app_icon_8"
                    android:background="@drawable/widget_background_alt"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="1dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1">
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/widget_text"
                        android:gravity="center"
                        android:id="@+id/app_initial_8"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text=""
                        android:fontFamily="@font/nothing_font"/>
                    <ImageView
                        android:id="@+id/app_image_8"
                        android:padding="4dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/app_icon"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/app_icon_9"
                    android:background="@drawable/widget_background_alt"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="1dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1">
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/widget_text"
                        android:gravity="center"
                        android:id="@+id/app_initial_9"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text=""
                        android:fontFamily="@font/nothing_font"/>
                    <ImageView
                        android:id="@+id/app_image_9"
                        android:padding="4dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/app_icon"/>
                </FrameLayout>
            </GridLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
