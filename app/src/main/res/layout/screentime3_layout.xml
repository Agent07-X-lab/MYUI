<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_background"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"/>
    <RelativeLayout
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/progress_bar_image"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:scaleType="fitXY"
            android:adjustViewBounds="false"
            android:layout_alignParentBottom="true"
            android:contentDescription="Usage Progress Bar"
            android:clipToOutline="true"/>
        <LinearLayout
            android:gravity="start|top"
            android:orientation="vertical"
            android:id="@+id/screentime_info_group"
            android:padding="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/progress_bar_image"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true">
            <ImageView
                android:layout_gravity="start"
                android:id="@+id/screentime_time_image"
                android:tag="font/mainb.otf"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:layout_marginBottom="5dp"
                android:adjustViewBounds="true"
                android:tint="@color/widget_text"
                android:contentDescription="Screen Time Duration. Tap to refresh."/>
            <ImageView
                android:layout_gravity="start"
                android:id="@+id/screentime_title_image"
                android:tag="font/mainb.otf"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="15dp"
                android:adjustViewBounds="true"
                android:contentDescription="Screen Time"
                android:alpha="0.4"/>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
