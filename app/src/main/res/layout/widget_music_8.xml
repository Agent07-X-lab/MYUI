<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:backgroundTint="@color/widget_background_light"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/widget_content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="10">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="5">
            <ImageView
                android:id="@+id/album_art"
                android:background="@drawable/widget_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/default_album_art"
                android:scaleType="centerCrop"
                android:contentDescription="Album art"
                android:clipToOutline="true"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/text_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2.5"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <ImageView
                android:id="@+id/song_title_img"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:alpha="1"/>
            <ImageView
                android:id="@+id/artist_name_img"
                android:layout_width="wrap_content"
                android:layout_height="12dp"
                android:layout_marginTop="2dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:alpha="0.7"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/controls_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2.5">
            <ImageView
                android:id="@+id/prev_button"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_music_widget3_previous"/>
            <ImageButton
                android:id="@+id/play_pause_button"
                android:background="@drawable/capsul_bg"
                android:padding="6dp"
                android:layout_width="65dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_music_widget3_play"
                android:scaleType="fitCenter"
                android:contentDescription="Play/Pause"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:backgroundTint="@color/widget_accent"/>
            <ImageView
                android:id="@+id/next_button"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_music_widget3_next"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
