<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_container"
        android:background="@drawable/capsul_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="@color/widget_background_light"/>
    <RelativeLayout
        android:id="@+id/compass_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/compass_dial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true">
            <TextView
                android:textSize="10sp"
                android:textStyle="normal"
                android:textColor="@color/widget_text"
                android:id="@+id/label_north"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="S"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="10sp"
                android:textStyle="normal"
                android:textColor="@color/widget_accent"
                android:id="@+id/label_south"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="N"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="10sp"
                android:textStyle="normal"
                android:textColor="@color/widget_text"
                android:id="@+id/label_east"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="W"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:rotation="270"/>
            <TextView
                android:textSize="10sp"
                android:textStyle="normal"
                android:textColor="@color/widget_text"
                android:id="@+id/label_west"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:text="E"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:rotation="90"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/compass_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/compass_arrow"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:maxWidth="80dp"
            android:maxHeight="80dp"
            android:layout_centerInParent="true"
            android:contentDescription="Compass arrow"/>
    </RelativeLayout>
</RelativeLayout>
