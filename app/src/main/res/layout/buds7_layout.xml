<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:backgroundTint="@color/widget_background_light"
        android:clipToOutline="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="start|bottom"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.65"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">
            <ImageView
                android:id="@+id/buds_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:src="@drawable/ic_buds4"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="@string/bluetooth_widget_description"/>
            <ImageView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:maxHeight="12dp"
                android:contentDescription="@string/bluetooth_widget_description"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/widget_text"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/subtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="no buds found"
                android:maxLines="1"
                android:singleLine="true"
                android:alpha="0.7"
                android:textAlignment="viewStart"/>
        </LinearLayout>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.35">
            <ProgressBar
                android:id="@+id/volume_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progress="70"
                android:progressDrawable="@drawable/vertical_volume_progress"
                android:secondaryProgressTint="@color/widget_background_light"
                style="?android:attr/progressBarStyleHorizontal"/>
            <FrameLayout
                android:layout_gravity="top"
                android:id="@+id/volume_up_area"
                android:background="@android:color/transparent"
                android:layout_width="match_parent"
                android:layout_height="60dp">
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"/>
            </FrameLayout>
            <FrameLayout
                android:layout_gravity="bottom"
                android:id="@+id/volume_down_area"
                android:background="@android:color/transparent"
                android:layout_width="match_parent"
                android:layout_height="60dp">
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"/>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
