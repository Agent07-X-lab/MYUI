<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/crop_root_layout"
    android:background="#121212"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.canhub.cropper.CropImageView
        android:id="@+id/crop_image_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_controls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar"/>
    <RelativeLayout
        android:id="@+id/top_bar"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:contentDescription="Cancel"
            android:backgroundTint="#40000000"
            app:icon="@drawable/ic_close"
            app:iconTint="@android:color/white"
            style="@style/Widget.Material3.Button.IconButton"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_rotate_top"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#40000000"
                app:icon="@drawable/ic_rotate_right"
                app:iconTint="@android:color/white"
                style="@style/Widget.Material3.Button.IconButton"/>
            <com.google.android.material.button.MaterialButton
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:id="@+id/btn_crop_done"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Save"
                app:backgroundTint="@android:color/white"
                app:cornerRadius="22dp"
                style="@style/Widget.Material3.Button.UnelevatedButton"/>
        </LinearLayout>
    </RelativeLayout>
    <ProgressBar
        android:id="@+id/crop_progress"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="@android:color/white"
        app:layout_constraintBottom_toBottomOf="@+id/crop_image_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/crop_image_view"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottom_controls"
        android:background="@drawable/rounded_widget_background"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#e0111111"
        app:layout_constraintBottom_toBottomOf="parent">
        <View
            android:layout_gravity="center_horizontal"
            android:background="#33ffffff"
            android:layout_width="36dp"
            android:layout_height="3.5dp"
            android:layout_marginTop="10dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="24dp">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_rotate_left"
                app:tint="@android:color/darker_gray"/>
            <SeekBar
                android:id="@+id/rotation_slider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:max="360"
                android:progress="0"
                android:layout_weight="1"
                android:splitTrack="false"
                android:progressTint="@android:color/white"
                android:thumbTint="@android:color/white"/>
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_rotate_right"
                app:tint="@android:color/darker_gray"/>
        </LinearLayout>
        <HorizontalScrollView
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="16dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ratio_orig"
                    android:text="Free"
                    style="@style/RatioChip"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ratio_1_1"
                    android:text="1:1"
                    style="@style/RatioChip"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ratio_9_16"
                    android:text="9:16"
                    style="@style/RatioChip"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ratio_16_9"
                    android:text="16:9"
                    style="@style/RatioChip"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ratio_3_4"
                    android:text="3:4"
                    style="@style/RatioChip"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ratio_4_3"
                    android:text="4:3"
                    style="@style/RatioChip"/>
            </LinearLayout>
        </HorizontalScrollView>
        <View
            android:background="#20ffffff"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="64dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_flip_horizontal"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:contentDescription="Flip horizontal"
                android:backgroundTint="@android:color/transparent"
                app:icon="@drawable/ic_flip_horizontal"
                app:iconTint="@android:color/white"
                style="@style/Widget.Material3.Button.IconButton"/>
            <View
                android:layout_width="48dp"
                android:layout_height="0dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_flip_vertical"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:contentDescription="Flip vertical"
                android:backgroundTint="@android:color/transparent"
                app:icon="@drawable/ic_flip_vertical"
                app:iconTint="@android:color/white"
                style="@style/Widget.Material3.Button.IconButton"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
