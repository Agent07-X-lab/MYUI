<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/widget_sound_three_state_2x2_description">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:backgroundTint="@color/widget_background_light"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/status_icon_container"
            android:background="@drawable/capsul_bg_light"
            android:padding="35dp"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginBottom="8dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/status_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_general"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="Current sound mode icon"/>
        </FrameLayout>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/profile_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Sound"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="@font/nothing_font"/>
    </LinearLayout>
</FrameLayout>
