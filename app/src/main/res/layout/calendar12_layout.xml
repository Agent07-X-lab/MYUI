<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:backgroundTint="@color/widget_background_light"/>
    <LinearLayout
        android:orientation="horizontal"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.6">
            <FrameLayout
                android:id="@+id/time_container"
                android:background="@drawable/widget_background_small_corners"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="10dp"
                android:layout_weight="1"
                android:foregroundGravity="center"
                android:backgroundTint="@color/widget_background_light">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/time_display"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="Time display"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/date_container"
                android:background="@drawable/widget_background_small_corners"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:foregroundGravity="center"
                android:backgroundTint="@color/widget_background_light">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/date_day_display"
                        android:layout_width="wrap_content"
                        android:layout_height="25dp"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:contentDescription="Day number"/>
                    <ImageView
                        android:id="@+id/date_month_display"
                        android:layout_width="wrap_content"
                        android:layout_height="25dp"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:contentDescription="Month name"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.4"
            android:foregroundGravity="center">
            <AnalogClock
                android:layout_gravity="center"
                android:id="@+id/analog_clock"
                android:background="@drawable/widget_analog_b_circular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:dial="@drawable/analog14b"
                android:hand_hour="@drawable/analog1_h"
                android:hand_minute="@drawable/analog1_m"
                android:hand_second="@drawable/analog1_s"
                android:dialTint="@color/widget_background_light"
                android:hand_hourTint="@color/widget_text"
                android:hand_minuteTint="@color/widget_text"
                android:hand_secondTint="@color/widget_accent"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
