<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="@color/widget_background_light"/>
    <RelativeLayout
        android:id="@+id/widget_layout_root"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/iv_quote_top_left"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_quote"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_quote_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="6"
            android:includeFontPadding="true"
            android:layout_centerInParent="true"
            android:lineSpacingMultiplier="1.1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>
        <TextView
            android:textSize="10sp"
            android:textStyle="normal"
            android:textColor="@color/widget_text"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_author_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:layout_below="@+id/tv_quote_text"
            android:alpha="0.7"/>
        <ImageView
            android:id="@+id/iv_quote_bottom_right"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_quote"
            android:layout_alignParentBottom="true"
            android:rotation="180"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
