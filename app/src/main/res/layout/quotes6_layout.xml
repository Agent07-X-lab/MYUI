<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="@color/widget_background_light"/>
    <RelativeLayout
        android:id="@+id/widget_content"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/iv_quote_top_left"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_folderapp_quotes"
            android:tint="@color/widget_accent"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/tv_quote_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="6"
            android:includeFontPadding="true"
            android:layout_centerInParent="true"
            android:lineSpacingMultiplier="1.1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="@color/widget_text"
            android:ellipsize="end"
            android:id="@+id/tv_author_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:maxLines="1"
            android:layout_alignParentBottom="true"
            android:alpha="0.6"
            android:layout_marginEnd="12dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
