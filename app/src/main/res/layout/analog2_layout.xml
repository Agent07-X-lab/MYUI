<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"/>
    <AnalogClock
        android:id="@+id/analog_clock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:dial="@drawable/widget_analog_16_b"
        android:hand_hour="@drawable/analog1_h"
        android:hand_minute="@drawable/analog1_m"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:hand_second="@drawable/analog1_s"
        android:dialTint="@color/widget_background_light"
        android:hand_hourTint="@color/widget_text"
        android:hand_minuteTint="@color/widget_text"
        android:hand_secondTint="@color/widget_accent"/>
    <TextClock
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:id="@+id/timeview"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:format12Hour="hh:mm"
        android:format24Hour="HH:mm:ss"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/widget_text"
        android:id="@+id/daydate"
        android:paddingLeft="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today&apos;s Friday, 12 May"/>
</RelativeLayout>
