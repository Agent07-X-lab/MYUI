<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:backgroundTint="@color/widget_background_light"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/album_art_parent_container"
                    android:background="@drawable/widget_background_small_corners"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/widget_background_light"
                    android:clipToOutline="true">
                    <FrameLayout
                        android:layout_gravity="center"
                        android:id="@+id/album_art_container"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:minWidth="80dp"
                        android:minHeight="80dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/album_art"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:alpha="0.7"/>
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/album_art2"
                            android:background="@drawable/capsul_bg_stroke"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                        <ProgressBar
                            android:layout_gravity="center"
                            android:id="@+id/circular_progress"
                            android:layout_width="wrap_content"
                            android:layout_height="150dp"
                            android:max="10000"
                            android:progress="0"
                            android:indeterminate="false"
                            android:progressDrawable="@drawable/circular_progress_circular"
                            style="?android:attr/progressBarStyleHorizontal"/>
                    </FrameLayout>
                </LinearLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="5dp"
                    android:layout_weight="1">
                    <ImageButton
                        android:id="@+id/next_button"
                        android:background="@drawable/widget_background_small_corners"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_music_widget3_next"
                        android:contentDescription="Next track"
                        android:backgroundTint="@color/widget_background_light"/>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="5dp"
                    android:layout_weight="1">
                    <ImageButton
                        android:id="@+id/play_pause_button"
                        android:background="@drawable/widget_background_small_corners"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_play"
                        android:contentDescription="Play/Pause"
                        android:backgroundTint="@color/widget_accent"/>
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="5dp"
                    android:layout_weight="1">
                    <ImageButton
                        android:id="@+id/prev_button"
                        android:background="@drawable/widget_background_small_corners"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_music_widget3_previous"
                        android:contentDescription="Previous track"
                        android:backgroundTint="@color/widget_background_light"/>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
