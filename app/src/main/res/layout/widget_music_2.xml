<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="@color/widget_background_light"/>
    <ImageView
        android:id="@+id/blurred_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.4"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="10">
        <LinearLayout
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="3.5">
            <ImageView
                android:id="@+id/album_art"
                android:background="@drawable/album_art_rounded"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/default_album_art"
                android:scaleType="centerCrop"
                android:clipToOutline="true"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="6.5"
            android:paddingStart="8dp">
            <ImageView
                android:id="@+id/song_title_img"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:scaleType="fitStart"
                android:adjustViewBounds="true"/>
            <ImageView
                android:id="@+id/artist_name_img"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginTop="1dp"
                android:scaleType="fitStart"
                android:adjustViewBounds="true"
                android:alpha="0.7"/>
            <ImageView
                android:id="@+id/time_labels_img"
                android:layout_width="wrap_content"
                android:layout_height="12dp"
                android:layout_marginTop="2dp"
                android:scaleType="fitStart"
                android:adjustViewBounds="true"/>
            <ProgressBar
                android:id="@+id/music_progress"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp"
                android:max="100"
                android:indeterminate="false"
                android:progressDrawable="@drawable/music_progress_horizontal"
                style="@android:style/Widget.ProgressBar.Horizontal"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="1">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/play_capsule"
                    android:background="@drawable/capsul_bg"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="60dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginEnd="10dp">
                    <ImageView
                        android:id="@+id/play_pause_button"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_music_widget3_play"
                        android:scaleType="fitCenter"/>
                    <ImageView
                        android:id="@+id/play_pause_text_img"
                        android:layout_width="wrap_content"
                        android:layout_height="10dp"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/prev_button"
                    android:padding="6dp"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_music_widget3_previous"
                    android:layout_marginEnd="10dp"/>
                <ImageView
                    android:id="@+id/next_button"
                    android:padding="6dp"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_music_widget3_next"
                    android:layout_marginEnd="10dp"/>
                <ImageView
                    android:id="@+id/heart_button"
                    android:padding="6dp"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_heart"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
