<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:backgroundTint="@color/widget_background_light">
        <LinearLayout
            android:id="@+id/google_capsule"
            android:background="@drawable/widget_background_small_corners"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="20dp"
            android:backgroundTint="@color/widget_accent_blue"
            android:paddingHorizontal="28dp"
            android:paddingVertical="8dp">
            <ImageView
                android:id="@+id/google_logo"
                android:layout_width="60dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_google_logo"
                android:scaleType="fitCenter"
                android:tint="@color/widget_text"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="end"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="18dp">
            <ImageView
                android:id="@+id/gemini_icon"
                android:background="@drawable/widget_background_small_corners"
                android:padding="6dp"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_gemini"
                android:scaleType="fitCenter"
                android:tint="@color/widget_text"
                android:contentDescription="Gemini"
                android:layout_marginEnd="12dp"
                android:backgroundTint="@color/widget_background_light"/>
            <ImageView
                android:id="@+id/lens_icon"
                android:background="@drawable/widget_background_small_corners"
                android:padding="6dp"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_google_lens"
                android:scaleType="fitCenter"
                android:tint="@color/widget_text"
                android:contentDescription="Google Lens"
                android:layout_marginEnd="12dp"
                android:backgroundTint="@color/widget_background_light"/>
            <ImageView
                android:id="@+id/chrome_icon"
                android:background="@drawable/widget_background_small_corners"
                android:padding="6dp"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_chrome"
                android:scaleType="fitCenter"
                android:tint="@color/widget_text"
                android:contentDescription="Chrome"
                android:backgroundTint="@color/widget_background_light"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
