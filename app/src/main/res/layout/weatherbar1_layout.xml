<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:backgroundTint="@color/widget_background_light"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/content_container"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <FrameLayout
                android:id="@+id/temp_container"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginEnd="12dp">
                <ImageView
                    android:id="@+id/temp_circle_background"
                    android:padding="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_background_small_corners"
                    android:scaleType="fitXY"/>
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:id="@+id/temperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/mainb"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/widget_text"
                    android:id="@+id/weather_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textAllCaps="true"
                    android:fontFamily="@font/mainb"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/widget_text"
                    android:id="@+id/low_high_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:alpha="0.6"
                    android:fontFamily="@font/mainr"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/weather_icon"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:scaleType="fitCenter"/>
    </LinearLayout>
</RelativeLayout>
