<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:backgroundTint="@color/widget_background_light"/>
    <RelativeLayout
        android:id="@+id/widgetLayout"
        android:padding="0dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/topSection"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_above="@+id/centerIcon"
            android:layout_alignParentTop="true">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/sunriseTimeLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <TextView
                    android:id="@+id/sunriseTimeText"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ImageView
                    android:id="@+id/sunriseTimeImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tint="@color/widget_text"
                    android:contentDescription="Sunrise Time"/>
            </LinearLayout>
        </RelativeLayout>
        <ImageView
            android:id="@+id/centerIcon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_sunset_sunrise"
            android:adjustViewBounds="true"
            android:layout_centerInParent="true"
            android:contentDescription="Sunrise and Sunset"/>
        <RelativeLayout
            android:id="@+id/bottomSection"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_below="@+id/centerIcon"
            android:layout_alignParentBottom="true">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/sunsetTimeLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <TextView
                    android:id="@+id/sunsetTimeText"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ImageView
                    android:id="@+id/sunsetTimeImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tint="@color/widget_text"
                    android:contentDescription="Sunset Time"/>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</FrameLayout>
