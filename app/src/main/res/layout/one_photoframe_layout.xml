<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:padding="0dp"
    android:focusable="true"
    android:clickable="true"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_photo"
        android:padding="0dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:cropToPadding="false"
        android:contentDescription="@string/widget_photo_description"/>
    <TextView
        android:textSize="18sp"
        android:textColor="#ffffff"
        android:id="@+id/config_text"
        android:background="@drawable/capsul_bg_gradient"
        android:padding="16dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap to configure"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/custom_text_top"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:contentDescription="@string/widget_custom_text"/>
    <ImageView
        android:id="@+id/custom_text_center"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:contentDescription="@string/widget_custom_text"/>
    <ImageView
        android:id="@+id/custom_text_bottom"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:contentDescription="@string/widget_custom_text"/>
</RelativeLayout>
