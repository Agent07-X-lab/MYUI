<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/background_circle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:backgroundTint="@color/widget_background_light"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/buds_progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/central_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="40dp">
        <ImageView
            android:id="@+id/buds_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/ic_buds2"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="@string/bluetooth_widget_description"/>
        <ImageView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:maxHeight="12dp"
            android:contentDescription="@string/bluetooth_widget_description"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/widget_text"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/subtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="120dp"
            android:text="no buds found"
            android:maxLines="2"
            android:alpha="0.7"
            android:textAlignment="center"/>
    </LinearLayout>
</FrameLayout>
