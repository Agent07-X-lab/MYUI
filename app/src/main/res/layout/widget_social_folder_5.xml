<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:backgroundTint="@color/widget_background_light"/>
    <LinearLayout
        android:orientation="horizontal"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="2">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:weightSum="2"
            android:layout_weight="1">
            <FrameLayout
                android:id="@+id/slot_container_0"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_margin="3dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/slot_bg_0"
                    android:background="@drawable/widget_background_small_corners"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/slot_icon_0"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:scaleType="fitCenter"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/slot_container_1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_margin="3dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/slot_bg_1"
                    android:background="@drawable/widget_background_small_corners"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/slot_icon_1"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:scaleType="fitCenter"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:weightSum="2"
            android:layout_weight="1">
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:rowCount="2"
                android:columnCount="2">
                <FrameLayout
                    android:id="@+id/slot_container_2"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="2dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1">
                    <ImageView
                        android:id="@+id/slot_bg_2"
                        android:background="@drawable/widget_background_small_corners"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/slot_icon_2"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:scaleType="fitCenter"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/slot_container_3"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="2dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1">
                    <ImageView
                        android:id="@+id/slot_bg_3"
                        android:background="@drawable/widget_background_small_corners"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/slot_icon_3"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:scaleType="fitCenter"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/slot_container_4"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="2dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1">
                    <ImageView
                        android:id="@+id/slot_bg_4"
                        android:background="@drawable/widget_background_small_corners"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/slot_icon_4"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:scaleType="fitCenter"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/slot_container_5"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="2dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1">
                    <ImageView
                        android:id="@+id/slot_bg_5"
                        android:background="@drawable/widget_background_small_corners"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/slot_icon_5"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:scaleType="fitCenter"/>
                </FrameLayout>
            </GridLayout>
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:rowCount="2"
                android:columnCount="2">
                <FrameLayout
                    android:id="@+id/slot_container_6"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="2dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1">
                    <ImageView
                        android:id="@+id/slot_bg_6"
                        android:background="@drawable/widget_background_small_corners"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/slot_icon_6"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:scaleType="fitCenter"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/slot_container_7"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="2dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1">
                    <ImageView
                        android:id="@+id/slot_bg_7"
                        android:background="@drawable/widget_background_small_corners"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/slot_icon_7"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:scaleType="fitCenter"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/slot_container_8"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="2dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1">
                    <ImageView
                        android:id="@+id/slot_bg_8"
                        android:background="@drawable/widget_background_small_corners"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/slot_icon_8"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:scaleType="fitCenter"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/slot_container_9"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="2dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1">
                    <ImageView
                        android:id="@+id/slot_bg_9"
                        android:background="@drawable/widget_background_small_corners"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/slot_icon_9"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:scaleType="fitCenter"/>
                </FrameLayout>
            </GridLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
