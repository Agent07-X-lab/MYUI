<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_background"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:backgroundTint="@color/widget_background_light"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/song_title"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"/>
            <ImageView
                android:id="@+id/artist_name"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:alpha="0.7"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <ImageView
                    android:id="@+id/prev_button"
                    android:background="@drawable/capsul_bg"
                    android:padding="8dp"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_previous"
                    android:backgroundTint="#15000000"/>
                <ImageView
                    android:id="@+id/play_pause_button"
                    android:background="@drawable/capsul_bg"
                    android:padding="10dp"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_music_widget3_play"
                    android:layout_marginStart="10dp"/>
                <ImageView
                    android:id="@+id/next_button"
                    android:background="@drawable/capsul_bg"
                    android:padding="8dp"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_music_widget3_next"
                    android:layout_marginStart="10dp"
                    android:backgroundTint="#15000000"/>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="8dp">
            <ImageView
                android:id="@+id/progress_capsule"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/capsul_bg"
                android:scaleType="fitXY"
                android:alpha="0.2"/>
            <ProgressBar
                android:id="@+id/song_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:max="100"
                android:progressDrawable="@drawable/custom_progress_bar_horizontal_pill"
                style="?android:attr/progressBarStyleHorizontal"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
