<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:background="@android:color/transparent"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/widget_clip_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToOutline="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/widget_bg_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"/>
        <RelativeLayout
            android:id="@+id/widget_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/camera_icon"
                android:background="@drawable/one_widget_camera1_fg"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:contentDescription="@string/camera_widget_description"/>
            <ImageView
                android:id="@+id/camera_icon2"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/one_widget_camera1"
                android:layout_centerInParent="true"
                android:contentDescription="@string/camera_widget_description"/>
        </RelativeLayout>
    </FrameLayout>
</FrameLayout>
