<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@null"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/widget_forecast_layout"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2.2">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/main_bento_bg"
                android:background="@drawable/calc4_btn_bg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1.8"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp">
                <ImageView
                    android:id="@+id/weather_icon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:scaleType="fitCenter"
                    android:layout_marginEnd="12dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text"
                        android:id="@+id/current_temperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/mainb"/>
                    <TextView
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text"
                        android:ellipsize="end"
                        android:id="@+id/weather_condition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:alpha="0.75"
                        android:fontFamily="@font/mainb"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/humidity_bento_bg"
                    android:background="@drawable/calc4_btn_bg"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="8dp">
                    <ImageView
                        android:id="@+id/humidity_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_waterdrop"
                        android:scaleType="fitCenter"
                        android:layout_marginEnd="6dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text"
                        android:id="@+id/humidity_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/mainb"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/wind_bento_bg"
                    android:background="@drawable/calc4_btn_bg"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="8dp">
                    <ImageView
                        android:id="@+id/wind_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/weather_wind"
                        android:scaleType="fitCenter"
                        android:layout_marginEnd="6dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text"
                        android:id="@+id/wind_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/mainb"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.3">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/aqi_bento_bg"
                android:background="@drawable/calc4_btn_bg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp">
                <ImageView
                    android:id="@+id/aqi_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_airq"
                    android:scaleType="fitCenter"
                    android:layout_marginEnd="8dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text"
                        android:id="@+id/aqi_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/mainb"/>
                    <TextView
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text"
                        android:id="@+id/aqi_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AIR QUALITY"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:alpha="0.55"
                        android:fontFamily="@font/mainb"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/uv_bento_bg"
                android:background="@drawable/calc4_btn_bg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp">
                <ImageView
                    android:id="@+id/uv_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_uv_1"
                    android:scaleType="fitCenter"
                    android:layout_marginEnd="8dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text"
                        android:id="@+id/uv_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/mainb"/>
                    <TextView
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text"
                        android:id="@+id/uv_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UV INDEX"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:alpha="0.55"
                        android:fontFamily="@font/mainb"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/widget_accent"
                android:id="@+id/city_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:fontFamily="@font/mainb"/>
            <TextView
                android:textSize="8sp"
                android:textColor="@color/widget_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  •  "
                android:alpha="0.35"/>
            <TextView
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text"
                android:id="@+id/date_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:alpha="0.65"
                android:fontFamily="@font/mainb"/>
            <TextView
                android:textSize="8sp"
                android:textColor="@color/widget_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  •  "
                android:alpha="0.35"/>
            <TextView
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text"
                android:id="@+id/time_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:alpha="0.65"
                android:fontFamily="@font/mainb"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
