<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@null"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/widget_forecast_layout"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="6dp"
            android:layout_weight="1.1"
            android:paddingHorizontal="4dp">
            <LinearLayout
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/current_weather_icon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:scaleType="fitCenter"
                    android:layout_marginEnd="10dp"/>
                <TextView
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:id="@+id/current_temperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/mainb"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="end|center_vertical"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_accent"
                    android:ellipsize="end"
                    android:id="@+id/city_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/mainb"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:ellipsize="end"
                    android:id="@+id/current_condition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:alpha="0.65"
                    android:fontFamily="@font/mainb"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/bottom_section"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.9">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/hour1_container"
                android:background="@drawable/calc4_btn_bg"
                android:padding="4dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:id="@+id/hour1_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:alpha="0.75"
                    android:fontFamily="@font/mainb"/>
                <ImageView
                    android:id="@+id/hour1_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:scaleType="fitCenter"
                    android:layout_marginVertical="3dp"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:id="@+id/hour1_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/mainb"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/hour2_container"
                android:background="@drawable/calc4_btn_bg"
                android:padding="4dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:id="@+id/hour2_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:alpha="0.75"
                    android:fontFamily="@font/mainb"/>
                <ImageView
                    android:id="@+id/hour2_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:scaleType="fitCenter"
                    android:layout_marginVertical="3dp"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:id="@+id/hour2_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/mainb"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/hour3_container"
                android:background="@drawable/calc4_btn_bg"
                android:padding="4dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:id="@+id/hour3_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:alpha="0.75"
                    android:fontFamily="@font/mainb"/>
                <ImageView
                    android:id="@+id/hour3_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:scaleType="fitCenter"
                    android:layout_marginVertical="3dp"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:id="@+id/hour3_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/mainb"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/hour4_container"
                android:background="@drawable/calc4_btn_bg"
                android:padding="4dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:id="@+id/hour4_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:alpha="0.75"
                    android:fontFamily="@font/mainb"/>
                <ImageView
                    android:id="@+id/hour4_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:scaleType="fitCenter"
                    android:layout_marginVertical="3dp"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:id="@+id/hour4_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/mainb"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/hour5_container"
                android:background="@drawable/calc4_btn_bg"
                android:padding="4dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:id="@+id/hour5_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:alpha="0.75"
                    android:fontFamily="@font/mainb"/>
                <ImageView
                    android:id="@+id/hour5_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:scaleType="fitCenter"
                    android:layout_marginVertical="3dp"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:id="@+id/hour5_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/mainb"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/hour6_container"
                android:background="@drawable/calc4_btn_bg"
                android:padding="4dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:id="@+id/hour6_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:alpha="0.75"
                    android:fontFamily="@font/mainb"/>
                <ImageView
                    android:id="@+id/hour6_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:scaleType="fitCenter"
                    android:layout_marginVertical="3dp"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:id="@+id/hour6_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/mainb"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
