<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:backgroundTint="@color/widget_background_light"/>
    <LinearLayout
        android:orientation="horizontal"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/time_container"
            android:padding="4dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4">
            <TextClock
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/widget_accent"
                android:id="@+id/widget_time_hour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-bold"
                android:format12Hour="hh"
                android:format24Hour="HH"/>
            <TextClock
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text"
                android:id="@+id/widget_time_minute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-bold"
                android:format12Hour="mm"
                android:format24Hour="mm"/>
            <TextClock
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text"
                android:id="@+id/widget_time_second"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-bold"
                android:format12Hour="ss"
                android:format24Hour="ss"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:weightSum="2"
            android:layout_weight="3"
            android:layout_marginStart="8dp">
            <FrameLayout
                android:id="@+id/day_button"
                android:background="@drawable/widget_background_small_corners"
                android:padding="6dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/widget_background_light">
                <AnalogClock
                    android:layout_gravity="center"
                    android:id="@+id/analog_clock"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:dial="@drawable/analog5b"
                    android:hand_hour="@drawable/analog1_h"
                    android:hand_minute="@drawable/analog1_m"
                    android:hand_second="@drawable/analog1_s"/>
            </FrameLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/date_button"
                android:background="@drawable/widget_background_small_corners"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:backgroundTint="@color/widget_background_light">
                <TextClock
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:id="@+id/widget_day_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.5"
                    android:textAllCaps="true"
                    android:fontFamily="sans-serif-bold"
                    android:format12Hour="EEE"
                    android:format24Hour="EEE"/>
                <TextClock
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:id="@+id/widget_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-4dp"
                    android:fontFamily="sans-serif-bold"
                    android:format12Hour="d"
                    android:format24Hour="d"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
