<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:backgroundTint="@color/widget_background_light"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/tv_dice_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:tint="@color/widget_text"
        android:contentDescription="Roll A Dice Text"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_dice"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="10dp"
        android:src="@drawable/ic_dice6"
        android:scaleType="fitCenter"
        android:contentDescription="Dice roll animation"/>
</FrameLayout>
