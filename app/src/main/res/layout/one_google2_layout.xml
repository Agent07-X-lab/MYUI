<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:backgroundTint="@color/widget_background_light"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_container"
        android:padding="6dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1">
            <FrameLayout
                android:id="@+id/google_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/google_logo_image"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_google_logo"
                    android:scaleType="fitStart"
                    android:adjustViewBounds="true"
                    android:tint="@color/widget_text"
                    android:layout_marginStart="14dp"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/lens_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/lens_logo_image"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_google_lens"
                    android:scaleType="fitEnd"
                    android:adjustViewBounds="true"
                    android:tint="@color/widget_text"
                    android:layout_marginEnd="15dp"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <FrameLayout
                android:id="@+id/gmail_button"
                android:background="@drawable/widget_background_small_corners"
                android:padding="8dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/widget_background_light">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/gmail_icon"
                    android:padding="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_gmail"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:maxWidth="35dp"
                    android:maxHeight="35dp"
                    android:tint="@color/widget_accent"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/photos_button"
                android:background="@drawable/widget_background_small_corners"
                android:padding="8dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/widget_background_light">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/photos_icon"
                    android:padding="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_google_photos"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:maxWidth="35dp"
                    android:maxHeight="35dp"
                    android:tint="@color/widget_accent"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/chrome_button"
                android:background="@drawable/widget_background_small_corners"
                android:padding="8dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/widget_background_light">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/chrome_icon"
                    android:padding="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_chrome"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:maxWidth="35dp"
                    android:maxHeight="35dp"
                    android:tint="@color/widget_accent"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/youtube_button"
                android:background="@drawable/widget_background_small_corners"
                android:padding="8dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/widget_background_light">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/youtube_icon"
                    android:padding="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_youtube"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:maxWidth="35dp"
                    android:maxHeight="35dp"
                    android:tint="@color/widget_accent"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <FrameLayout
                android:id="@+id/pay_button"
                android:background="@drawable/widget_background_small_corners"
                android:padding="8dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/widget_background_light">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/pay_icon"
                    android:padding="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_google_pay"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:maxWidth="35dp"
                    android:maxHeight="35dp"
                    android:tint="@color/widget_accent"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/drive_button"
                android:background="@drawable/widget_background_small_corners"
                android:padding="8dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/widget_background_light">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/drive_icon"
                    android:padding="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_google_drive"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:maxWidth="35dp"
                    android:maxHeight="35dp"
                    android:tint="@color/widget_accent"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/incognito_button"
                android:background="@drawable/widget_background_small_corners"
                android:padding="8dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/widget_background_light">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/incognito_icon"
                    android:padding="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_incognito"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:maxWidth="35dp"
                    android:maxHeight="35dp"
                    android:tint="@color/widget_accent"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/playstore_button"
                android:background="@drawable/widget_background_small_corners"
                android:padding="8dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/widget_background_light">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/playstore_icon"
                    android:padding="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_google_playstore"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:maxWidth="35dp"
                    android:maxHeight="35dp"
                    android:tint="@color/widget_accent"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
