<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/analogb"
        android:adjustViewBounds="true"/>
    <AnalogClock
        android:layout_gravity="center"
        android:id="@+id/analog_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:dial="@drawable/analog8b"
        android:hand_hour="@drawable/analog8h"
        android:hand_minute="@drawable/analog8m"
        android:hand_second="@drawable/analog8s"
        android:dialTint="@color/widget_background_light"
        android:hand_hourTint="@color/widget_text"
        android:hand_minuteTint="@color/widget_text"
        android:hand_secondTint="@color/widget_accent"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/widget_text"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/daydate"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
