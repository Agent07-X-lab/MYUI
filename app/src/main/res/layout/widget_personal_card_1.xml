<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_profile1"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">
            <ImageView
                android:id="@+id/iv_name_bitmap"
                android:padding="3dp"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:scaleType="fitStart"
                android:adjustViewBounds="true"/>
            <ImageView
                android:id="@+id/iv_sublabel_bitmap"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginTop="2dp"
                android:scaleType="fitStart"
                android:adjustViewBounds="true"
                android:alpha="0.5"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/social_icons_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_social_1"
                android:padding="6dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="fitCenter"
                android:layout_marginEnd="4dp"/>
            <ImageView
                android:id="@+id/iv_social_2"
                android:padding="6dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="fitCenter"
                android:layout_marginEnd="4dp"/>
            <ImageView
                android:id="@+id/iv_social_3"
                android:padding="6dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="fitCenter"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
