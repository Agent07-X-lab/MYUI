<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:backgroundTint="@color/widget_background_light"/>
    <GridLayout
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:rowCount="6"
        android:columnCount="4">
        <TextView
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textColor="@color/widget_text"
            android:ellipsize="end"
            android:gravity="end|center_vertical"
            android:layout_gravity="fill"
            android:id="@+id/display"
            android:padding="6dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="0"
            android:maxLines="2"
            android:layout_columnSpan="4"
            android:layout_rowWeight="1.5"
            android:layout_columnWeight="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeMaxTextSize="48sp"/>
        <Button
            android:textColor="@color/widget_text"
            android:layout_gravity="fill"
            android:id="@+id/btn_clear"
            android:background="@drawable/widget_background_small_corners"
            android:padding="2dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="AC"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#878787"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="12sp"/>
        <Button
            android:textColor="@color/widget_text"
            android:layout_gravity="fill"
            android:id="@+id/btn_backspace"
            android:background="@drawable/widget_background_small_corners"
            android:padding="2dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="del"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#878787"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="12sp"/>
        <Button
            android:textColor="@color/widget_text"
            android:layout_gravity="fill"
            android:id="@+id/btn_percent"
            android:background="@drawable/widget_background_small_corners"
            android:padding="2dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="%"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#878787"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="15sp"/>
        <Button
            android:layout_gravity="fill"
            android:id="@+id/btn_divide"
            android:background="@drawable/widget_background_small_corners"
            android:padding="2dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="÷"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/widget_accent"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="16sp"/>
        <Button
            android:textColor="@color/widget_text"
            android:layout_gravity="fill"
            android:id="@+id/btn_7"
            android:background="@drawable/widget_background_small_corners"
            android:padding="2dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="7"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/widget_background_light"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="16sp"/>
        <Button
            android:textColor="@color/widget_text"
            android:layout_gravity="fill"
            android:id="@+id/btn_8"
            android:background="@drawable/widget_background_small_corners"
            android:padding="2dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="8"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/widget_background_light"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="16sp"/>
        <Button
            android:textColor="@color/widget_text"
            android:layout_gravity="fill"
            android:id="@+id/btn_9"
            android:background="@drawable/widget_background_small_corners"
            android:padding="2dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="9"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/widget_background_light"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="16sp"/>
        <Button
            android:layout_gravity="fill"
            android:id="@+id/btn_multiply"
            android:background="@drawable/widget_background_small_corners"
            android:padding="2dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="×"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/widget_accent"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="16sp"/>
        <Button
            android:textColor="@color/widget_text"
            android:layout_gravity="fill"
            android:id="@+id/btn_4"
            android:background="@drawable/widget_background_small_corners"
            android:padding="2dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="4"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/widget_background_light"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="16sp"/>
        <Button
            android:textColor="@color/widget_text"
            android:layout_gravity="fill"
            android:id="@+id/btn_5"
            android:background="@drawable/widget_background_small_corners"
            android:padding="2dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="5"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/widget_background_light"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="16sp"/>
        <Button
            android:textColor="@color/widget_text"
            android:layout_gravity="fill"
            android:id="@+id/btn_6"
            android:background="@drawable/widget_background_small_corners"
            android:padding="2dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="6"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/widget_background_light"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="16sp"/>
        <Button
            android:layout_gravity="fill"
            android:id="@+id/btn_minus"
            android:background="@drawable/widget_background_small_corners"
            android:padding="2dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="-"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/widget_accent"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="20sp"/>
        <Button
            android:textColor="@color/widget_text"
            android:layout_gravity="fill"
            android:id="@+id/btn_1"
            android:background="@drawable/widget_background_small_corners"
            android:padding="2dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="1"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/widget_background_light"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="16sp"/>
        <Button
            android:textColor="@color/widget_text"
            android:layout_gravity="fill"
            android:id="@+id/btn_2"
            android:background="@drawable/widget_background_small_corners"
            android:padding="2dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="2"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/widget_background_light"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="16sp"/>
        <Button
            android:textColor="@color/widget_text"
            android:layout_gravity="fill"
            android:id="@+id/btn_3"
            android:background="@drawable/widget_background_small_corners"
            android:padding="2dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="3"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/widget_background_light"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="16sp"/>
        <Button
            android:layout_gravity="fill"
            android:id="@+id/btn_plus"
            android:background="@drawable/widget_background_small_corners"
            android:padding="2dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="+"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/widget_accent"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="16sp"/>
        <Button
            android:textColor="@color/widget_text"
            android:layout_gravity="fill"
            android:id="@+id/btn_0"
            android:background="@drawable/widget_background_small_corners"
            android:padding="2dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="0"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_columnSpan="2"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/widget_background_light"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="16sp"/>
        <Button
            android:textColor="@color/widget_text"
            android:layout_gravity="fill"
            android:id="@+id/btn_dot"
            android:background="@drawable/widget_background_small_corners"
            android:padding="2dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="."
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/widget_background_light"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="16sp"/>
        <Button
            android:layout_gravity="fill"
            android:id="@+id/btn_equals"
            android:background="@drawable/widget_background_small_corners"
            android:padding="2dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:text="="
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:stateListAnimator="@null"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/widget_accent"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="6sp"
            android:autoSizeMaxTextSize="16sp"/>
    </GridLayout>
</FrameLayout>
