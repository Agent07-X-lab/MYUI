<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:backgroundTint="@color/widget_background_light"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_container"
        android:padding="0dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/name_container"
            android:background="@drawable/widget_background_small_corners"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="2"
            android:backgroundTint="@color/widget_background_light">
            <ImageView
                android:id="@+id/contact_name"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="center"/>
            <ImageButton
                android:layout_gravity="end|top"
                android:id="@+id/reconfigure_button"
                android:background="@android:color/transparent"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="4dp"
                android:src="@android:drawable/ic_menu_edit"
                android:contentDescription="@string/reconfigure_widget"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:layout_weight="1">
            <FrameLayout
                android:id="@+id/message_button"
                android:background="@drawable/widget_background_small_corners"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@color/widget_background_light">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_contact_message"
                    android:contentDescription="@string/message_contact"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/call_button"
                android:background="@drawable/widget_background_small_corners"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="@color/widget_accent">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_contact_call"
                    android:contentDescription="@string/call_contact"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
