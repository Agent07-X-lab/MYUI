<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:backgroundTint="@color/widget_background_light"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="1">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/water_icon"
                android:paddingBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:src="@drawable/ic_waterdrop"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:tint="@color/widget_accent"
                android:alpha="0.6"/>
            <ImageView
                android:id="@+id/water_amount"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:layout_marginTop="0dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"/>
            <ImageView
                android:id="@+id/water_remaining"
                android:paddingTop="5dp"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginTop="4dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:alpha="0.8"/>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="4dp">
            <ImageView
                android:id="@+id/progress_capsule"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/capsul_bg"
                android:scaleType="fitXY"
                android:alpha="0.2"/>
            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="6dp"
                android:max="100"
                android:progressDrawable="@drawable/custom_progress_bar_horizontal_pill"
                style="?android:attr/progressBarStyleHorizontal"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
