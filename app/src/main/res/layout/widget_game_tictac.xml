<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:backgroundTint="@color/widget_background_light"/>
    <GridLayout
        android:id="@+id/grid_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="16dp"
        android:rowCount="3"
        android:columnCount="3">
        <ImageView
            android:id="@+id/cell_0"
            android:padding="8dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:tint="@color/widget_text"
            android:contentDescription="Cell 0"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"/>
        <ImageView
            android:id="@+id/cell_1"
            android:padding="8dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:tint="@color/widget_text"
            android:contentDescription="Cell 1"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"/>
        <ImageView
            android:id="@+id/cell_2"
            android:padding="8dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:tint="@color/widget_text"
            android:contentDescription="Cell 2"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"/>
        <ImageView
            android:id="@+id/cell_3"
            android:padding="8dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:tint="@color/widget_text"
            android:contentDescription="Cell 3"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"/>
        <ImageView
            android:id="@+id/cell_4"
            android:padding="8dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:tint="@color/widget_text"
            android:contentDescription="Cell 4"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"/>
        <ImageView
            android:id="@+id/cell_5"
            android:padding="8dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:tint="@color/widget_text"
            android:contentDescription="Cell 5"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"/>
        <ImageView
            android:id="@+id/cell_6"
            android:padding="8dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:tint="@color/widget_text"
            android:contentDescription="Cell 6"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"/>
        <ImageView
            android:id="@+id/cell_7"
            android:padding="8dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:tint="@color/widget_text"
            android:contentDescription="Cell 7"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"/>
        <ImageView
            android:id="@+id/cell_8"
            android:padding="8dp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:tint="@color/widget_text"
            android:contentDescription="Cell 8"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"/>
    </GridLayout>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/game_status"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:tint="@color/widget_text"
        android:contentDescription="Game Status"/>
</FrameLayout>
