<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:backgroundTint="@color/widget_background_light"/>
    <LinearLayout
        android:gravity="start"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3.5">
            <ImageView
                android:id="@+id/ic_waterdrop"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/ic_water_smile"
                android:scaleType="fitCenter"
                android:tint="@color/widget_accent"
                android:contentDescription="Water drop icon"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="bottom|center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4">
            <ImageView
                android:id="@+id/water_amount"
                android:layout_width="wrap_content"
                android:layout_height="15dp"
                android:layout_marginBottom="5dp"
                android:scaleType="fitStart"
                android:adjustViewBounds="true"
                android:maxHeight="42dp"
                android:tint="@color/widget_text"
                android:contentDescription="Water amount"/>
            <ImageView
                android:id="@+id/water_remaining"
                android:layout_width="wrap_content"
                android:layout_height="12dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:scaleType="fitStart"
                android:adjustViewBounds="true"
                android:maxHeight="24dp"
                android:tint="@color/widget_text"
                android:contentDescription="Water remaining"
                android:alpha="0.4"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="start|bottom"
            android:orientation="horizontal"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.75">
            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:max="100"
                android:progress="0"
                android:indeterminate="false"
                android:progressDrawable="@drawable/progress_bar_wifi_on"
                android:backgroundTint="@android:color/transparent"
                style="?android:attr/progressBarStyleHorizontal"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
