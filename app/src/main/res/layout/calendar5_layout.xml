<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:backgroundTint="@color/widget_background_light"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/header_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp">
                <TextView
                    android:textSize="10sp"
                    android:textColor="#808080"
                    android:id="@+id/tv_year_progress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="YEAR PROGRESS"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.15"/>
                <TextClock
                    android:textSize="10sp"
                    android:textColor="#808080"
                    android:id="@+id/tv_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:format12Hour="hh:mm a"
                    android:format24Hour="HH:mm"
                    android:letterSpacing="0.1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text"
                        android:id="@+id/days_left_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="308 days left"
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/widget_alt"
                        android:id="@+id/until_year_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="until 2025"
                        android:fontFamily="sans-serif"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="end"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:id="@+id/speech_bubble_container"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextClock
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text"
                        android:id="@+id/current_date_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="0dp"
                        android:fontFamily="sans-serif-bold"
                        android:format12Hour="dd"
                        android:format24Hour="dd"/>
                    <TextClock
                        android:textSize="10sp"
                        android:textColor="@color/widget_alt"
                        android:id="@+id/day_month_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAllCaps="true"
                        android:fontFamily="sans-serif-medium"
                        android:format12Hour="EEE MMM"
                        android:format24Hour="EEE MMM"
                        android:letterSpacing="0.05"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
