<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_container"
        android:background="@drawable/capsul_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="@color/widget_background_light"/>
    <RelativeLayout
        android:id="@+id/compass_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/compass_dial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true">
            <ImageView
                android:id="@+id/compass_dial_base"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/compass3dial_base"
                android:scaleType="fitCenter"/>
            <ImageView
                android:id="@+id/compass_dial_accent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/compass3dial_accent"
                android:scaleType="fitCenter"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/compass_arrow"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/compass_arrow"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:maxWidth="35dp"
            android:maxHeight="35dp"
            android:layout_centerInParent="true"
            android:contentDescription="Compass arrow"/>
    </RelativeLayout>
</RelativeLayout>
