<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:backgroundTint="@color/widget_background_light"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <ImageView
                android:id="@+id/widget_day"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="@string/day_of_week"/>
            <ImageView
                android:id="@+id/widget_date"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="@string/date_number"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/widget_curl"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/curl_effect"
            android:scaleType="fitEnd"
            android:adjustViewBounds="true"
            android:layout_alignParentBottom="true"
            android:contentDescription="@null"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</FrameLayout>
