<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/content_container"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:layout_marginEnd="6dp">
            <LinearLayout
                android:gravity="end|center_vertical"
                android:orientation="vertical"
                android:id="@+id/display_container"
                android:background="@drawable/calc4_display_bg"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="6dp"
                android:layout_weight="2.8"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/widget_text"
                    android:ellipsize="start"
                    android:gravity="end"
                    android:id="@+id/formula_display"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=" "
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:alpha="0.55"
                    android:fontFamily="@font/mainr"/>
                <TextView
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:gravity="end|center_vertical"
                    android:id="@+id/display"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:text="0"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:fontFamily="@font/mainb"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="34sp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.2">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:gravity="center"
                    android:id="@+id/btn_copy"
                    android:background="@drawable/calc4_btn_bg"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="Copy"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:fontFamily="@font/mainb"
                    android:layout_marginEnd="3dp"/>
                <TextView
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_accent"
                    android:gravity="center"
                    android:id="@+id/btn_equals"
                    android:background="@drawable/calc4_btn_bg"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="="
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:fontFamily="@font/mainb"
                    android:layout_marginStart="3dp"/>
            </LinearLayout>
        </LinearLayout>
        <GridLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.6"
            android:rowCount="4"
            android:columnCount="4"
            android:layout_marginStart="6dp">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text"
                android:gravity="center"
                android:id="@+id/btn_7"
                android:background="@drawable/calc4_btn_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="2.5dp"
                android:text="7"
                android:includeFontPadding="false"
                android:fontFamily="@font/mainb"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text"
                android:gravity="center"
                android:id="@+id/btn_8"
                android:background="@drawable/calc4_btn_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="2.5dp"
                android:text="8"
                android:includeFontPadding="false"
                android:fontFamily="@font/mainb"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text"
                android:gravity="center"
                android:id="@+id/btn_9"
                android:background="@drawable/calc4_btn_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="2.5dp"
                android:text="9"
                android:includeFontPadding="false"
                android:fontFamily="@font/mainb"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/widget_accent"
                android:gravity="center"
                android:id="@+id/btn_divide"
                android:background="@drawable/calc4_btn_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="2.5dp"
                android:text="÷"
                android:includeFontPadding="false"
                android:fontFamily="@font/mainb"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text"
                android:gravity="center"
                android:id="@+id/btn_4"
                android:background="@drawable/calc4_btn_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="2.5dp"
                android:text="4"
                android:includeFontPadding="false"
                android:fontFamily="@font/mainb"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text"
                android:gravity="center"
                android:id="@+id/btn_5"
                android:background="@drawable/calc4_btn_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="2.5dp"
                android:text="5"
                android:includeFontPadding="false"
                android:fontFamily="@font/mainb"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text"
                android:gravity="center"
                android:id="@+id/btn_6"
                android:background="@drawable/calc4_btn_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="2.5dp"
                android:text="6"
                android:includeFontPadding="false"
                android:fontFamily="@font/mainb"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/widget_accent"
                android:gravity="center"
                android:id="@+id/btn_multiply"
                android:background="@drawable/calc4_btn_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="2.5dp"
                android:text="×"
                android:includeFontPadding="false"
                android:fontFamily="@font/mainb"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text"
                android:gravity="center"
                android:id="@+id/btn_1"
                android:background="@drawable/calc4_btn_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="2.5dp"
                android:text="1"
                android:includeFontPadding="false"
                android:fontFamily="@font/mainb"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text"
                android:gravity="center"
                android:id="@+id/btn_2"
                android:background="@drawable/calc4_btn_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="2.5dp"
                android:text="2"
                android:includeFontPadding="false"
                android:fontFamily="@font/mainb"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text"
                android:gravity="center"
                android:id="@+id/btn_3"
                android:background="@drawable/calc4_btn_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="2.5dp"
                android:text="3"
                android:includeFontPadding="false"
                android:fontFamily="@font/mainb"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/widget_accent"
                android:gravity="center"
                android:id="@+id/btn_minus"
                android:background="@drawable/calc4_btn_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="2.5dp"
                android:text="−"
                android:includeFontPadding="false"
                android:fontFamily="@font/mainb"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text"
                android:gravity="center"
                android:id="@+id/btn_clear"
                android:background="@drawable/calc4_btn_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="2.5dp"
                android:text="C"
                android:includeFontPadding="false"
                android:fontFamily="@font/mainb"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text"
                android:gravity="center"
                android:id="@+id/btn_0"
                android:background="@drawable/calc4_btn_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="2.5dp"
                android:text="0"
                android:includeFontPadding="false"
                android:fontFamily="@font/mainb"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text"
                android:gravity="center"
                android:id="@+id/btn_dot"
                android:background="@drawable/calc4_btn_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="2.5dp"
                android:text="."
                android:includeFontPadding="false"
                android:fontFamily="@font/mainb"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/widget_accent"
                android:gravity="center"
                android:id="@+id/btn_plus"
                android:background="@drawable/calc4_btn_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="2.5dp"
                android:text="+"
                android:includeFontPadding="false"
                android:fontFamily="@font/mainb"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"/>
        </GridLayout>
    </LinearLayout>
</FrameLayout>
