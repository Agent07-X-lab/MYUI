<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:layout_centerInParent="true"
        android:backgroundTint="@color/widget_background_light"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:layout_centerInParent="true">
        <LinearLayout
            android:id="@+id/search_capsule"
            android:background="@drawable/widget_background_small_corners"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="20dp"
            android:paddingHorizontal="28dp"
            android:paddingVertical="8dp">
            <ImageView
                android:id="@+id/chatgpt_text_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="end"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="18dp">
            <ImageView
                android:id="@+id/gemini_icon"
                android:background="@drawable/widget_background_small_corners"
                android:padding="6dp"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_gemini"
                android:scaleType="fitCenter"
                android:tint="@color/widget_text"
                android:contentDescription="Gemini"
                android:layout_marginEnd="12dp"
                android:backgroundTint="@color/widget_background_light"/>
            <ImageView
                android:id="@+id/grok_icon"
                android:background="@drawable/widget_background_small_corners"
                android:padding="6dp"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_grok"
                android:scaleType="fitCenter"
                android:tint="@color/widget_text"
                android:contentDescription="Grok"
                android:layout_marginEnd="12dp"
                android:backgroundTint="@color/widget_background_light"/>
            <ImageView
                android:id="@+id/deepseek_icon"
                android:background="@drawable/widget_background_small_corners"
                android:padding="6dp"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_deepseek"
                android:scaleType="fitCenter"
                android:tint="@color/widget_text"
                android:contentDescription="Deepseek"
                android:backgroundTint="@color/widget_background_light"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
