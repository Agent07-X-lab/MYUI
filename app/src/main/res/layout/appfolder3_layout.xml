<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:backgroundTint="@color/widget_background_light"/>
    <GridLayout
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:rowCount="2"
        android:columnCount="2">
        <FrameLayout
            android:id="@+id/app_icon_0"
            android:background="@drawable/widget_background_alt"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/widget_text"
                android:gravity="center"
                android:id="@+id/app_initial_0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/tap_to_configure"
                android:fontFamily="@font/nothing_font"/>
            <ImageView
                android:id="@+id/app_image_0"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_icon"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/app_icon_1"
            android:background="@drawable/widget_background_alt"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/widget_text"
                android:gravity="center"
                android:id="@+id/app_initial_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text=""
                android:fontFamily="@font/nothing_font"/>
            <ImageView
                android:id="@+id/app_image_1"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_icon"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/app_icon_2"
            android:background="@drawable/widget_background_alt"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/widget_text"
                android:gravity="center"
                android:id="@+id/app_initial_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text=""
                android:fontFamily="@font/nothing_font"/>
            <ImageView
                android:id="@+id/app_image_2"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_icon"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/app_icon_3"
            android:background="@drawable/widget_background_alt"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/widget_text"
                android:gravity="center"
                android:id="@+id/app_initial_3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text=""
                android:fontFamily="@font/nothing_font"/>
            <ImageView
                android:id="@+id/app_image_3"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_icon"/>
        </FrameLayout>
    </GridLayout>
</FrameLayout>
