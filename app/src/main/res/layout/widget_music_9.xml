<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/record_container"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/vinyl_base"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/vinyl_record"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/circular_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/album_art"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/default_album_art"
            android:scaleType="centerCrop"/>
        <ImageButton
            android:layout_gravity="center"
            android:id="@+id/play_pause_button"
            android:background="@drawable/capsul_bg"
            android:padding="10dp"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/ic_music_widget3_play"
            android:scaleType="fitCenter"
            android:elevation="4dp"
            android:backgroundTint="@color/widget_accent"/>
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/prev_button"
            android:padding="6dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_music_widget3_previous"
            android:alpha="1"
            android:layout_marginStart="12dp"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/next_button"
            android:padding="6dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_music_widget3_next"
            android:alpha="1"
            android:layout_marginEnd="12dp"/>
    </FrameLayout>
</RelativeLayout>
