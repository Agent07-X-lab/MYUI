<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:backgroundTint="@color/widget_background_light"/>
    <LinearLayout
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_gravity="center">
            <AnalogClock
                android:layout_gravity="center"
                android:id="@+id/analog_clock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:dial="@drawable/analog11b"
                android:hand_hour="@drawable/analog8h"
                android:hand_minute="@drawable/analog8m"
                android:hand_second="@drawable/analog8s"
                android:dialTint="@color/widget_text_secondary"
                android:hand_hourTint="@color/widget_text"
                android:hand_minuteTint="@color/widget_text"
                android:hand_secondTint="@color/widget_accent"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:gravity="center"
                    android:id="@+id/header_day_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="S"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:gravity="center"
                    android:id="@+id/header_day_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="M"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:gravity="center"
                    android:id="@+id/header_day_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="T"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:gravity="center"
                    android:id="@+id/header_day_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="W"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:gravity="center"
                    android:id="@+id/header_day_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="T"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:gravity="center"
                    android:id="@+id/header_day_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="F"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:gravity="center"
                    android:id="@+id/header_day_6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="S"
                    android:layout_weight="1"/>
            </LinearLayout>
            <include
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                layout="@layout/calendar10_month_grid"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
