<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@null"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/widget_forecast_layout"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/widget_accent"
            android:ellipsize="end"
            android:id="@+id/city_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:fontFamily="@font/mainb"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text"
                android:id="@+id/current_temperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:fontFamily="@font/mainb"/>
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text"
                android:gravity="end"
                android:id="@+id/current_max_temp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:alpha="0.7"
                android:fontFamily="@font/mainb"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/day1_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:id="@+id/day1_name"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:alpha="0.75"
                    android:fontFamily="@font/mainb"/>
                <ImageView
                    android:id="@+id/day1_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:scaleType="fitCenter"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:gravity="end"
                    android:id="@+id/day1_temp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:fontFamily="@font/mainb"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/day2_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:id="@+id/day2_name"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:alpha="0.75"
                    android:fontFamily="@font/mainb"/>
                <ImageView
                    android:id="@+id/day2_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:scaleType="fitCenter"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:gravity="end"
                    android:id="@+id/day2_temp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:fontFamily="@font/mainb"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/day3_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:id="@+id/day3_name"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:alpha="0.75"
                    android:fontFamily="@font/mainb"/>
                <ImageView
                    android:id="@+id/day3_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:scaleType="fitCenter"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:gravity="end"
                    android:id="@+id/day3_temp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:fontFamily="@font/mainb"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/day4_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:id="@+id/day4_name"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:alpha="0.75"
                    android:fontFamily="@font/mainb"/>
                <ImageView
                    android:id="@+id/day4_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:scaleType="fitCenter"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text"
                    android:gravity="end"
                    android:id="@+id/day4_temp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:fontFamily="@font/mainb"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
