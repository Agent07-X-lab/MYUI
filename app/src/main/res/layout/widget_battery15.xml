<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:backgroundTint="@color/widget_background_light"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/mobile_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ProgressBar
                    android:id="@+id/mobile_circular_progress"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:max="100"
                    android:progress="50"
                    android:indeterminate="false"
                    android:progressDrawable="@drawable/circular_progress_battery_green"
                    android:rotation="-90"
                    style="?android:attr/progressBarStyleHorizontal"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/device_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_device"
                    android:scaleType="centerInside"
                    android:tint="@color/widget_text"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/mobile_percentage_image"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginTop="12dp"
                android:adjustViewBounds="true"
                android:tint="@color/widget_text"
                android:contentDescription="@string/app_name"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/earbuds_container"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ProgressBar
                    android:id="@+id/earbuds_circular_progress"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:max="100"
                    android:progress="50"
                    android:indeterminate="false"
                    android:progressDrawable="@drawable/circular_progress_battery_green"
                    android:rotation="-90"
                    style="?android:attr/progressBarStyleHorizontal"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/earbuds_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_airbuds"
                    android:scaleType="centerInside"
                    android:tint="@color/widget_text"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/earbuds_percentage_image"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginTop="12dp"
                android:adjustViewBounds="true"
                android:tint="@color/widget_text"
                android:contentDescription="@string/app_name"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
