<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:backgroundTint="@color/widget_background_light"/>
    <LinearLayout
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/current_day_number"
                android:paddingBottom="6dp"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="Current day number"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"/>
            <ImageView
                android:id="@+id/current_day_name"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="Current day name"/>
            <ImageView
                android:id="@+id/current_month_name"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="Current month name"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_alt"
                    android:gravity="center"
                    android:id="@+id/header_day_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="S"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_alt"
                    android:gravity="center"
                    android:id="@+id/header_day_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="M"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_alt"
                    android:gravity="center"
                    android:id="@+id/header_day_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="T"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_alt"
                    android:gravity="center"
                    android:id="@+id/header_day_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="W"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_alt"
                    android:gravity="center"
                    android:id="@+id/header_day_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="T"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_alt"
                    android:gravity="center"
                    android:id="@+id/header_day_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="F"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_alt"
                    android:gravity="center"
                    android:id="@+id/header_day_6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="S"
                    android:layout_weight="1"/>
            </LinearLayout>
            <include
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                layout="@layout/calendar10_month_grid"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
