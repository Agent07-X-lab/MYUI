<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:backgroundTint="@color/widget_background_light"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/content_container"
        android:padding="0dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp">
            <FrameLayout
                android:id="@+id/name_container"
                android:background="@drawable/widget_background_small_corners"
                android:padding="5dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:backgroundTint="@color/widget_background_light">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/widget_text"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/contact_name"
                    android:padding="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tap_to_configure"
                    android:rotation="0"
                    android:fontFamily="@font/nothing_font"
                    android:letterSpacing="0.1"/>
                <ImageButton
                    android:layout_gravity="end|top"
                    android:id="@+id/reconfigure_button"
                    android:background="@android:color/transparent"
                    android:visibility="gone"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_margin="4dp"
                    android:src="@android:drawable/ic_menu_edit"
                    android:contentDescription="@string/reconfigure_widget"/>
            </FrameLayout>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <FrameLayout
                android:id="@+id/message_button"
                android:background="@drawable/widget_background_small_corners"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/widget_background_light">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_contact_message"
                    android:contentDescription="@string/message_contact"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/call_button"
                android:background="@drawable/widget_background_small_corners"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/widget_accent">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_contact_call"
                    android:contentDescription="@string/call_contact"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
