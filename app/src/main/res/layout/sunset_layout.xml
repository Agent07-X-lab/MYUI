<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/widget_outer_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/widget_root"
        android:padding="0dp"
        android:layout_width="match_parent"
        android:layout_height="85dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/widget_container"
            android:background="@drawable/widget_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:backgroundTint="@color/widget_background_light"/>
        <LinearLayout
            android:gravity="start"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToOutline="true">
            <LinearLayout
                android:gravity="start|center_vertical"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="7">
                <ImageView
                    android:id="@+id/sunset_location_image"
                    android:layout_width="wrap_content"
                    android:layout_height="11dp"
                    android:layout_marginBottom="5dp"
                    android:scaleType="fitStart"
                    android:adjustViewBounds="true"
                    android:tint="@color/widget_text"
                    android:contentDescription="@string/app_name"
                    android:alpha="0.4"/>
                <ImageView
                    android:id="@+id/sunset_time_image"
                    android:layout_width="wrap_content"
                    android:layout_height="13dp"
                    android:scaleType="fitStart"
                    android:adjustViewBounds="true"
                    android:tint="@color/widget_text"
                    android:baselineAlignBottom="true"
                    android:contentDescription="@string/app_name"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="bottom"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3">
                <ImageView
                    android:id="@+id/sunset_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_sunset"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="Sunset Icon"
                    android:clipToOutline="true"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</RelativeLayout>
