<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:backgroundTint="@color/widget_background_light"/>
    <ImageView
        android:id="@+id/bottom_right_background"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="10dp"
        android:src="@drawable/a"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:gravity="start"
        android:orientation="vertical"
        android:id="@+id/time_section"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="10dp"
        android:layout_alignParentStart="true">
        <TextClock
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text"
            android:id="@+id/widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-bold"
            android:format12Hour="hh:mm"
            android:format24Hour="HH:mm"/>
        <TextClock
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text"
            android:id="@+id/widget_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-6dp"
            android:alpha="0.5"
            android:textAllCaps="true"
            android:fontFamily="sans-serif-bold"
            android:format12Hour="EEEE"
            android:format24Hour="EEEE"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="start"
        android:orientation="vertical"
        android:id="@+id/bottom_left_section"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="10dp"
        android:layout_alignParentStart="true">
        <TextClock
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text"
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.5"
            android:textAllCaps="true"
            android:fontFamily="sans-serif-bold"
            android:format12Hour="d EEE"
            android:format24Hour="d EEE"
            android:letterSpacing="0.1"/>
    </LinearLayout>
</RelativeLayout>
