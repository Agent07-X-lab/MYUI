<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_background"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"/>
    <FrameLayout
        android:id="@+id/widget_container"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/app_launcher_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="15dp"
                android:textColor="@color/widget_text"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/app_launcher_text"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:text="click to edit"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/app_launcher_custom_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="23dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:tint="@color/widget_text"
                android:contentDescription="@string/app_text"/>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
