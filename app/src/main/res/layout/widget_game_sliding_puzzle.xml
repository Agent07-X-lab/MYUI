<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:backgroundTint="@color/widget_background_light"/>
    <GridLayout
        android:id="@+id/puzzle_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="15dp"
        android:rowCount="3"
        android:columnCount="3">
        <TextView
            android:textSize="24sp"
            android:textColor="@color/widget_text"
            android:gravity="center"
            android:id="@+id/tile_0"
            android:background="@drawable/puzzle_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/widget_background_light"/>
        <TextView
            android:textSize="24sp"
            android:textColor="@color/widget_text"
            android:gravity="center"
            android:id="@+id/tile_1"
            android:background="@drawable/puzzle_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/widget_background_light"/>
        <TextView
            android:textSize="24sp"
            android:textColor="@color/widget_text"
            android:gravity="center"
            android:id="@+id/tile_2"
            android:background="@drawable/puzzle_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/widget_background_light"/>
        <TextView
            android:textSize="24sp"
            android:textColor="@color/widget_text"
            android:gravity="center"
            android:id="@+id/tile_3"
            android:background="@drawable/puzzle_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/widget_background_light"/>
        <TextView
            android:textSize="24sp"
            android:textColor="@color/widget_text"
            android:gravity="center"
            android:id="@+id/tile_4"
            android:background="@drawable/puzzle_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/widget_background_light"/>
        <TextView
            android:textSize="24sp"
            android:textColor="@color/widget_text"
            android:gravity="center"
            android:id="@+id/tile_5"
            android:background="@drawable/puzzle_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/widget_background_light"/>
        <TextView
            android:textSize="24sp"
            android:textColor="@color/widget_text"
            android:gravity="center"
            android:id="@+id/tile_6"
            android:background="@drawable/puzzle_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/widget_background_light"/>
        <TextView
            android:textSize="24sp"
            android:textColor="@color/widget_text"
            android:gravity="center"
            android:id="@+id/tile_7"
            android:background="@drawable/puzzle_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/widget_background_light"/>
        <TextView
            android:textSize="24sp"
            android:textColor="@color/widget_text"
            android:gravity="center"
            android:id="@+id/tile_8"
            android:background="@drawable/puzzle_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="2dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="@color/widget_background_light"/>
    </GridLayout>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/widget_text"
        android:layout_gravity="center"
        android:id="@+id/game_status"
        android:background="@drawable/widget_background_alt"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You Win! Tap to shuffle."
        android:paddingStart="24dp"
        android:paddingEnd="24dp"/>
</FrameLayout>
