<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:backgroundTint="@color/widget_background_light"/>
    <ImageView
        android:id="@+id/cartoon_character"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginBottom="-15dp"
        android:src="@drawable/ic_corner_cartoon"
        android:scaleType="fitCenter"
        android:layout_alignParentBottom="true"
        android:alpha="0.9"
        android:layout_marginEnd="-5dp"
        android:layout_alignParentEnd="true"/>
    <FrameLayout
        android:id="@+id/chat_bubble_container"
        android:layout_width="100dp"
        android:layout_height="60dp"
        android:layout_marginTop="-15dp"
        android:layout_alignTop="@+id/cartoon_character"
        android:layout_marginEnd="-25dp"
        android:layout_toStartOf="@+id/cartoon_character">
        <ImageView
            android:id="@+id/chat_bubble"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_chatbubble"
            android:scaleType="fitCenter"
            android:tint="@color/widget_accent"/>
        <TextClock
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/widget_background"
            android:gravity="center"
            android:id="@+id/day_text"
            android:paddingBottom="0dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textAllCaps="true"
            android:fontFamily="sans-serif-bold"
            android:format12Hour="EEE, d MMM"
            android:format24Hour="EEE, d MMM"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/time_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/chat_bubble_container"
        android:layout_alignParentTop="true">
        <TextClock
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text"
            android:id="@+id/widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-bold"
            android:format12Hour="hh:mm"
            android:format24Hour="HH:mm"
            android:letterSpacing="-0.05"/>
    </LinearLayout>
</RelativeLayout>
