<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:backgroundTint="@color/widget_background_light"/>
    <LinearLayout
        android:orientation="horizontal"
        android:padding="0dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="-4dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/art_section"
                android:background="@drawable/widget_background"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_margin="0dp"
                android:layout_weight="1"
                android:backgroundTint="@color/widget_background_light"
                android:clipToOutline="true">
                <FrameLayout
                    android:layout_gravity="center"
                    android:id="@+id/album_art_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minWidth="80dp"
                    android:minHeight="80dp">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/album_art"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:alpha="1"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/album_art2"
                        android:background="@drawable/background_bg_stroke"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <ProgressBar
                        android:layout_gravity="center"
                        android:id="@+id/circular_progress"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="150dp"
                        android:max="10000"
                        android:progress="0"
                        android:indeterminate="false"
                        android:progressDrawable="@drawable/circular_progress_circular"
                        style="?android:attr/progressBarStyleHorizontal"/>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="-4dp"
            android:layout_weight="1">
            <FrameLayout
                android:id="@+id/button_section"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_margin="0dp"
                android:layout_weight="1">
                <ImageButton
                    android:id="@+id/play_pause_button"
                    android:background="@drawable/widget_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_music_widget3_play"
                    android:contentDescription="Play/Pause"
                    android:backgroundTint="@color/widget_background_light"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/album_art3"
                    android:background="@drawable/background_bg_stroke"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
