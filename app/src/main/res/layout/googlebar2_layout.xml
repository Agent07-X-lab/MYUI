<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background_on"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:backgroundTint="@color/widget_accent">
        <ImageView
            android:id="@+id/google_icon"
            android:background="@drawable/widget_background"
            android:padding="18dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/ic_google_color"
            android:scaleType="fitStart"
            android:layout_weight="0.85"
            android:contentDescription="@string/google_widget_description"
            android:backgroundTint="@color/widget_background_light"/>
        <ImageView
            android:id="@+id/assistant_icon"
            android:padding="18dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_gemini"
            android:scaleType="fitCenter"
            android:tint="@color/widget_background_light"
            android:contentDescription="Google Assistant"
            android:layout_marginEnd="4dp"/>
    </LinearLayout>
</RelativeLayout>
