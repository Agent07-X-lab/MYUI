<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:backgroundTint="@color/widget_background_light"/>
    <LinearLayout
        android:orientation="horizontal"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false">
        <LinearLayout
            android:gravity="start"
            android:orientation="vertical"
            android:id="@+id/battery_info_group"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="15dp">
            <ImageView
                android:layout_gravity="start"
                android:id="@+id/battery_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="4dp"
                android:src="@drawable/ic_charge"
                android:contentDescription="@null"/>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <ImageView
                android:layout_gravity="start"
                android:id="@+id/battery_percentage"
                android:tag="font/mainb.otf"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:scaleType="fitStart"
                android:adjustViewBounds="true"/>
            <ImageView
                android:layout_gravity="start"
                android:id="@+id/battery_status"
                android:tag="font/mainb.otf"
                android:layout_width="wrap_content"
                android:layout_height="12dp"
                android:layout_marginTop="6dp"
                android:scaleType="fitStart"
                android:adjustViewBounds="true"
                android:alpha="0.6"/>
            <ImageView
                android:layout_gravity="start"
                android:id="@+id/battery_time_remaining"
                android:tag="font/mainb.otf"
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_marginTop="6dp"
                android:scaleType="fitStart"
                android:adjustViewBounds="true"
                android:alpha="0.4"/>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:layout_width="14dp"
            android:layout_height="match_parent"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp">
            <ProgressBar
                android:id="@+id/battery_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progressDrawable="@drawable/custom_progress_bar_vertical"
                style="?android:attr/progressBarStyleHorizontal"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
