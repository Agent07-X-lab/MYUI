<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:padding="0dp"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/widget_background"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToOutline="true">
        <ImageView
            android:id="@+id/widget_photo"
            android:background="@drawable/rounded_widget_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/widget_photo_description"/>
        <TextView
            android:textSize="18sp"
            android:textColor="#ffffff"
            android:layout_gravity="center"
            android:id="@+id/config_text"
            android:background="#80000000"
            android:padding="16dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to configure"/>
        <ImageView
            android:layout_gravity="start|bottom"
            android:id="@+id/custom_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/widget_custom_text"
            android:layout_marginStart="12dp"/>
    </FrameLayout>
</RelativeLayout>
