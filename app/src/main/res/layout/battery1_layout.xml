<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:backgroundTint="@color/widget_background_light"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/ring_container_outer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="0.82">
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/ring_container_inner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ProgressBar
                    android:id="@+id/circular_progress"
                    android:padding="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:max="100"
                    android:progress="50"
                    android:indeterminate="false"
                    android:progressDrawable="@drawable/circular_progress_battery_green"
                    android:rotation="-90"
                    style="?android:attr/progressBarStyleHorizontal"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/battery_percentage_image"
                    android:padding="32dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"/>
            </FrameLayout>
        </FrameLayout>
        <ImageView
            android:id="@+id/battery_status_image"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:alpha="0.8"/>
    </LinearLayout>
</FrameLayout>
