<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:backgroundTint="@color/widget_background_light"/>
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/widget_content_root"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToOutline="true">
        <ImageView
            android:id="@+id/widget_music4_album_art"
            android:background="@drawable/widget_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:clipToOutline="true"/>
        <ImageView
            android:id="@+id/gradient_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/album_art_with_gradient2"
            android:scaleType="fitXY"
            android:tint="@color/widget_background_light"
            android:layout_above="@+id/bottom_control_panel"
            android:layout_alignParentTop="true"/>
        <FrameLayout
            android:id="@+id/bottom_control_panel"
            android:background="@drawable/widget_background_bottom_rounded"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true"
            android:backgroundTint="@color/widget_background_light">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/media_controls_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageButton
                    android:id="@+id/widget_music4_prev_button"
                    android:background="@drawable/music_widget4_button_ripple"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_music_widget3_previous"/>
                <ImageButton
                    android:id="@+id/widget_music4_play_pause_button"
                    android:background="@drawable/capsul_bg"
                    android:layout_width="80dp"
                    android:layout_height="33dp"
                    android:layout_marginLeft="0dp"
                    android:layout_marginRight="0dp"
                    android:src="@drawable/ic_play"/>
                <ImageButton
                    android:id="@+id/widget_music4_next_button"
                    android:background="@drawable/music_widget4_button_ripple"
                    android:padding="12dp"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_music_widget3_next"/>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/song_info_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:layout_above="@+id/bottom_control_panel"
            android:layout_marginStart="10dp"
            android:layout_alignParentStart="true">
            <ImageView
                android:id="@+id/widget_music4_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"/>
            <ImageView
                android:id="@+id/widget_music4_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:adjustViewBounds="true"/>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
