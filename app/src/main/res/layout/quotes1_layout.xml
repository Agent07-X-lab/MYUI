<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/widget_container"
        android:background="@drawable/widget_quotes1_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:backgroundTint="@color/widget_background_light"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/widget_layout_root"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/quote_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_fortune_logo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginBottom="8dp"
                android:src="@drawable/ic_quotes1_icon"
                android:scaleType="centerInside"
                android:tint="@color/widget_accent"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_quote_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="10"
                android:includeFontPadding="true"
                android:lineSpacingMultiplier="1.1"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
