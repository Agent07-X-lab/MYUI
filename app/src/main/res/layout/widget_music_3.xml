<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_container"
        android:background="@drawable/widget_image_rounded"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:backgroundTint="@color/widget_background_light"/>
    <RelativeLayout
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/left_section"
            android:background="@drawable/widget_image_rounded"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@+id/control_section"
            android:elevation="4dp"
            android:backgroundTint="@color/widget_background_light">
            <ImageView
                android:id="@+id/album_art"
                android:background="@drawable/album_art_with_gradient"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:tint="@color/black_transparent"
                android:clipToOutline="true"/>
            <ProgressBar
                android:id="@+id/song_progress"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginBottom="8dp"
                android:progress="30"
                android:layout_above="@+id/song_info_container"
                android:layout_marginHorizontal="12dp"
                style="?android:attr/progressBarStyleHorizontal"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/song_info_container"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true">
                <ImageView
                    android:layout_gravity="start"
                    android:id="@+id/song_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <ImageView
                    android:layout_gravity="start"
                    android:id="@+id/artist_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"/>
                <ImageView
                    android:layout_gravity="start"
                    android:id="@+id/timestamp_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:alpha="0.7"/>
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/control_section"
            android:background="@drawable/circular_background"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_margin="0dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:elevation="6dp"
            android:backgroundTint="@color/widget_background_light">
            <ImageButton
                android:id="@+id/center_circle"
                android:background="@null"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/circular_background"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"/>
            <ImageButton
                android:id="@+id/music_note"
                android:background="@drawable/music_widget3_button_ripple"
                android:padding="12dp"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_music_widget3_music"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"/>
            <ImageButton
                android:id="@+id/prev_button"
                android:background="@drawable/music_widget3_button_ripple"
                android:padding="12dp"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_music_widget3_previous"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <ImageButton
                android:id="@+id/next_button"
                android:background="@drawable/music_widget3_button_ripple"
                android:padding="12dp"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_music_widget3_next"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
            <ImageButton
                android:id="@+id/play_pause_button"
                android:background="@drawable/music_widget3_button_ripple"
                android:padding="14dp"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_music_widget3_play_pause"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </RelativeLayout>
</FrameLayout>
