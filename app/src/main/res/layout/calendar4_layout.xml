<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:background="@android:color/transparent"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">
    <ImageView
        android:id="@+id/widget_bg"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:clipToOutline="true"/>
    <ImageView
        android:id="@+id/widget_background"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:contentDescription="@string/calendar_widget4_background"
        android:clipToOutline="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/widget_text"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/config_text"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/calendar_widget4_configure"/>
    <LinearLayout
        android:layout_gravity="start|center_vertical"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/current_day_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/calendar_widget_day_description"/>
        <ImageView
            android:id="@+id/current_month_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/calendar_widget_date_description"/>
    </LinearLayout>
</FrameLayout>
