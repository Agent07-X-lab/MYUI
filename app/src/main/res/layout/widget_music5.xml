<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_music5_layout"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">
    <ImageView
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:scaleType="fitXY"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"
        android:backgroundTint="@color/widget_background_light"/>
    <ImageView
        android:id="@+id/widget_music5_album_art"
        android:background="@drawable/widget_background"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_margin="15dp"
        android:scaleType="centerCrop"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/song_info_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="10dp"
        android:layout_toEndOf="@+id/widget_music5_album_art">
        <ImageView
            android:id="@+id/widget_music5_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"/>
        <ImageView
            android:id="@+id/widget_music5_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:adjustViewBounds="true"
            android:alpha="0.7"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/media_controls_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="10dp"
        android:layout_alignParentEnd="true">
        <ImageButton
            android:id="@+id/widget_music5_forward_button"
            android:background="@drawable/music_widget4_button_ripple"
            android:layout_width="45dp"
            android:layout_height="35dp"
            android:src="@drawable/ic_previous"
            android:contentDescription="Previous Track"
            android:layout_marginStart="0dp"/>
        <ImageButton
            android:id="@+id/widget_music5_play_pause_button"
            android:background="@drawable/capsul_bg"
            android:layout_width="65dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_play"
            android:layout_marginHorizontal="5dp"/>
        <ImageButton
            android:id="@+id/widget_music5_next_button"
            android:background="@drawable/music_widget4_button_ripple"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_next"
            android:layout_marginStart="0dp"/>
    </LinearLayout>
</RelativeLayout>
