<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/widget_root"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_container"
        android:background="@drawable/widget_background"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:layout_centerInParent="true"
        android:backgroundTint="@color/widget_background_light"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:weightSum="5"
        android:layout_centerInParent="true">
        <FrameLayout
            android:id="@+id/chatgpt_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp">
            <ImageView
                android:id="@+id/chatgpt_bg"
                android:background="@drawable/widget_background_small_corners"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/chatgpt_icon"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_chatgpt"
                android:scaleType="fitCenter"
                android:tint="@color/widget_text"
                android:contentDescription="ChatGPT"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/gemini_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp">
            <ImageView
                android:id="@+id/gemini_bg"
                android:background="@drawable/widget_background_small_corners"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/gemini_icon"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_gemini"
                android:scaleType="fitCenter"
                android:tint="@color/widget_text"
                android:contentDescription="Gemini"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/grok_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp">
            <ImageView
                android:id="@+id/grok_bg"
                android:background="@drawable/widget_background_small_corners"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/grok_icon"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_grok"
                android:scaleType="fitCenter"
                android:tint="@color/widget_text"
                android:contentDescription="Grok"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/perplexity_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp">
            <ImageView
                android:id="@+id/perplexity_bg"
                android:background="@drawable/widget_background_small_corners"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/perplexity_icon"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_perplexity2"
                android:scaleType="fitCenter"
                android:tint="@color/widget_text"
                android:contentDescription="Perplexity"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/claude_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp">
            <ImageView
                android:id="@+id/claude_bg"
                android:background="@drawable/widget_background_small_corners"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/claude_icon"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_claude2"
                android:scaleType="fitCenter"
                android:tint="@color/widget_text"
                android:contentDescription="Claude"/>
        </FrameLayout>
    </LinearLayout>
</RelativeLayout>
