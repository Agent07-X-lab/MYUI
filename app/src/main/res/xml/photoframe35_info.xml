<?xml version="1.0" encoding="utf-8"?>
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_photo_description"
    android:minWidth="72dp"
    android:minHeight="72dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/one_photoframe_layout"
    android:previewImage="@drawable/ic_photoframe35"
    android:resizeMode="horizontal|vertical"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="1000dp"
    android:maxResizeHeight="1000dp"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable"
    android:targetCellWidth="2"
    android:targetCellHeight="2">
    <meta-data
        android:name="WIDGET_CLASS"
        android:value="com.jndapp.minimal.widgets.widgets.photoframe.Frame35"/>
</appwidget-provider>
